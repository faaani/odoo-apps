<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_bulk_download" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.bulk.download</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='emails']" position="after">
                <h2>Attachments</h2>
                <div class="row mt16 o_settings_container" id="attachment_bulk_download_container">
                    <div class="col-12 col-lg-6 o_setting_box" id="attachment_bulk_download_setting">
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Bulk Download Limit</span>
                            <div class="text-muted">
                                Largest total size one "Download Attachments" archive may reach. Set 0 to allow archives of any size.
                            </div>
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="attachment_bulk_download_max_mb" class="col-lg-6 o_light_label"/>
                                    <field name="attachment_bulk_download_max_mb" class="col-lg-2"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
