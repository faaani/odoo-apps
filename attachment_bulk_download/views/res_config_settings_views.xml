<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_bulk_download" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.bulk.download</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="before">
                <block title="Attachments" name="attachment_bulk_download_block">
                    <setting string="Bulk Download Limit (MB)" id="attachment_bulk_download_setting"
                             help="Largest total size one 'Download Attachments' archive may reach. Set 0 to allow archives of any size.">
                        <field name="attachment_bulk_download_max_mb" class="col-lg-2"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
