<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Choosing a model and its columns means reading Odoo's technical
            field list, which core reserves to Administration / Access Rights.
            Such a user manages their own exports only, and those exports run
            as themselves — so they can never receive a row they were not
            already allowed to read. Full administrators (Settings) see every
            export, because somebody has to be able to audit and stop them.
        -->
        <record id="scheduled_export_rule_own" model="ir.rule">
            <field name="name">Scheduled Export: own exports</field>
            <field name="model_id" ref="model_scheduled_export"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
        </record>

        <record id="scheduled_export_rule_admin" model="ir.rule">
            <field name="name">Scheduled Export: all exports (administrators)</field>
            <field name="model_id" ref="model_scheduled_export"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>

        <record id="scheduled_export_line_rule_own" model="ir.rule">
            <field name="name">Scheduled Export Column: own exports</field>
            <field name="model_id" ref="model_scheduled_export_line"/>
            <field name="domain_force">[('export_id.create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
        </record>

        <record id="scheduled_export_line_rule_admin" model="ir.rule">
            <field name="name">Scheduled Export Column: all exports (administrators)</field>
            <field name="model_id" ref="model_scheduled_export_line"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>
