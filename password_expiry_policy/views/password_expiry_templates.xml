<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="change_password_page" name="Password Expiry: Change Password">
        <t t-call="web.login_layout">
            <form class="oe_login_form" role="form" method="post" action="/password_expiry/change">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <p class="alert alert-warning" role="alert" t-if="expired">
                    Your password has expired. Choose a new one to continue.
                </p>
                <p class="text-muted small" t-if="not expired">
                    Choose a new password for your account.
                </p>

                <div class="mb-3">
                    <label for="user_login" class="col-form-label">User</label>
                    <input type="text" id="user_login" class="form-control" t-att-value="user_login"
                           readonly="readonly" disabled="disabled" autocomplete="username"/>
                </div>

                <div class="mb-3">
                    <label for="old_password" class="col-form-label">Current Password</label>
                    <input type="password" name="old_password" id="old_password" class="form-control"
                           required="required" autofocus="autofocus"
                           autocomplete="current-password" maxlength="4096"/>
                </div>

                <div class="mb-3">
                    <label for="new_password" class="col-form-label">New Password</label>
                    <input type="password" name="new_password" id="new_password" class="form-control"
                           required="required" autocomplete="new-password" maxlength="4096"/>
                </div>

                <div class="mb-3">
                    <label for="confirm_password" class="col-form-label">Confirm New Password</label>
                    <input type="password" name="confirm_password" id="confirm_password" class="form-control"
                           required="required" autocomplete="new-password" maxlength="4096"/>
                </div>

                <p class="alert alert-danger" role="alert" t-if="error">
                    <t t-esc="error"/>
                </p>

                <div class="text-center pt-3">
                    <button type="submit" class="btn btn-primary w-100">Change Password</button>
                    <a href="/web/session/logout" class="btn btn-link btn-sm">Log out</a>
                </div>
            </form>
        </t>
    </template>
</odoo>
