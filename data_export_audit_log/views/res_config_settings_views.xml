<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_export_audit_log" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.export.audit.log</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="before">
                <block title="Export Audit" name="export_audit_block">
                    <setting string="Export Log Retention (days)" id="export_log_retention_setting"
                             help="Exports made through the export dialog are logged under Settings / Export Audit Log. Entries older than the retention period are purged daily; 0 keeps them forever.">
                        <field name="export_log_retention_days" class="col-lg-2"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
