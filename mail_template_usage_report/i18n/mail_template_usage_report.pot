#. module: mail_template_usage_report
#: model_terms:ir.actions.act_window,help:mail_template_usage_report.action_mail_template_usage_report
msgid ""
"<b>Careful:</b> a template with no recorded use is not automatically\n"
"               safe to delete. Templates are also called from Python code and from the\n"
"               settings of other apps, which this report cannot see. Counting also only\n"
"               starts when this module is installed."
msgstr ""

#. module: mail_template_usage_report
#: model_terms:ir.ui.view,arch_db:mail_template_usage_report.view_mail_template_usage_report_form
msgid ""
"<strong>\"Never used\" is not a permission to delete.</strong>\n"
"                        Email templates are also called from Python code and from\n"
"                        configuration fields of other apps. This report only detects\n"
"                        sends recorded since it was installed, plus server actions,\n"
"                        automated actions and activity types pointing at the template.\n"
"                        Always check a template before removing it."
msgstr ""

