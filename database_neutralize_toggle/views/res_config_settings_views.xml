<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_sandbox" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.sandbox</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='emails']" position="after">
                <h2>Sandbox Mode</h2>
                <div class="row mt16 o_settings_container" id="sandbox_mode_container">
                    <div class="col-12 col-lg-6 o_setting_box" id="sandbox_mode_setting">
                        <div class="o_setting_left_pane">
                            <field name="sandbox_mode"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="sandbox_mode"/>
                            <div class="text-muted">
                                Snapshot and deactivate every outgoing mail server, incoming mail server and scheduled action, and show a warning banner. Switching it back off restores the exact previous state.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
