<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_bank_alert" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.bank.alert</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="before">
                <block title="Partner Bank Accounts" name="bank_alert_block">
                    <setting string="Bank Account Change Alerts" id="bank_alert_setting"
                             help="Audit every added, modified or removed bank account on the partner chatter and notify the alert group. Account numbers are always masked to the last 4 characters.">
                        <field name="bank_alert_enabled"/>
                        <div class="content-group" invisible="not bank_alert_enabled">
                            <div class="row mt16">
                                <label for="bank_alert_group_id" class="col-lg-4 o_light_label"/>
                                <field name="bank_alert_group_id" class="col-lg-6"
                                       placeholder="Default: accounting managers / Settings admins"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
