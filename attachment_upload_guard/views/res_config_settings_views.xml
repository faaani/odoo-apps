<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_upload_guard" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.upload.guard</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='emails']" position="after">
                <h2>Attachments</h2>
                <div class="row mt16 o_settings_container" id="attachment_guard_container">
                    <div class="col-12 col-lg-6 o_setting_box" id="attachment_guard_setting">
                        <div class="o_setting_left_pane">
                            <field name="attachment_guard_enabled"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="attachment_guard_enabled"/>
                            <div class="text-muted">
                                Refuse risky file types and oversized attachments. Reports, assets and imports are never affected.
                            </div>
                            <div class="content-group" attrs="{'invisible': [('attachment_guard_enabled', '=', False)]}">
                                <div class="row mt16">
                                    <label for="attachment_guard_extensions" class="col-lg-4 o_light_label"/>
                                    <field name="attachment_guard_extensions" class="col-lg-6"/>
                                </div>
                                <div class="row">
                                    <label for="attachment_guard_max_mb" class="col-lg-4 o_light_label"/>
                                    <field name="attachment_guard_max_mb" class="col-lg-2"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
