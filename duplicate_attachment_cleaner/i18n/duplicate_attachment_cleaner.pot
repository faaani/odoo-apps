#. module: duplicate_attachment_cleaner
#: model_terms:ir.ui.view,arch_db:duplicate_attachment_cleaner.duplicate_attachment_scan_view_form
msgid ""
"<strong>Anywhere in the database:</strong> only one copy of each file survives for\n"
"                        the whole database. Records whose own copy is removed keep no link to the file, and\n"
"                        a link built on an attachment id (an image pasted into an email template, a website\n"
"                        page or a description) breaks when that copy goes. Prefer\n"
"                        <em>Same record only</em> unless you know these copies are interchangeable."
msgstr ""

#. module: duplicate_attachment_cleaner
#: model_terms:ir.ui.view,arch_db:duplicate_attachment_cleaner.duplicate_attachment_scan_view_form
msgid ""
"<strong>Scanning never deletes anything.</strong> Attachments are grouped by the\n"
"                        checksum Odoo already stores; the list below is a report. Clean-up is a separate,\n"
"                        confirmed step that keeps the <strong>oldest</strong> copy of every group.\n"
"                        <br/>\n"
"                        Never reported and never deleted: attachments of the framework models\n"
"                        <code>ir.ui.view</code>, <code>ir.asset</code>, <code>ir.actions.report</code> and\n"
"                        <code>ir.module.module</code> (asset bundles and module plumbing), every attachment\n"
"                        that holds a binary field of a record — deleting those would empty the record's\n"
"                        field — and empty files."
msgstr ""

