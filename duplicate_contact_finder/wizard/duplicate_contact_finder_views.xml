<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_duplicate_contact_member_tree" model="ir.ui.view">
        <field name="name">duplicate.contact.member.tree</field>
        <field name="model">duplicate.contact.member</field>
        <field name="arch" type="xml">
            <list string="Contacts" create="false" edit="false" delete="false"
                  decoration-bf="is_most_active" decoration-muted="not partner_active">
                <field name="partner_active" column_invisible="1"/>
                <field name="partner_name"/>
                <field name="partner_email"/>
                <field name="partner_phone"/>
                <field name="partner_mobile"/>
                <field name="partner_create_date"/>
                <field name="activity_count"/>
                <field name="is_most_active" string="Most Activity"/>
                <field name="is_user" string="Login" optional="show"/>
                <field name="is_company" optional="hide"/>
                <button name="action_open_partner" type="object" icon="fa-external-link"
                        title="Open this contact"/>
            </list>
        </field>
    </record>

    <record id="view_duplicate_contact_group_form" model="ir.ui.view">
        <field name="name">duplicate.contact.group.form</field>
        <field name="model">duplicate.contact.group</field>
        <field name="arch" type="xml">
            <form string="Duplicate Group" create="false" delete="false">
                <header>
                    <button name="action_open_contacts" type="object" string="Open Contacts"
                            class="btn-secondary"/>
                    <button name="action_open_merge_wizard" type="object"
                            string="Merge in Odoo's Wizard" class="btn-primary"/>
                </header>
                <sheet>
                    <field name="members_truncated" invisible="1"/>
                    <group>
                        <group>
                            <field name="match_type"/>
                            <field name="match_value"/>
                            <field name="partner_count"/>
                            <field name="listed_count" invisible="not members_truncated"/>
                        </group>
                        <group>
                            <field name="first_created"/>
                            <field name="last_created"/>
                            <field name="top_partner_id"/>
                            <field name="top_activity_count"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="not members_truncated">
                        Only the first contacts of this group are listed. Use "Open
                        Contacts" to see all of them.
                    </div>
                    <field name="member_ids" nolabel="1" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_duplicate_contact_group_tree" model="ir.ui.view">
        <field name="name">duplicate.contact.group.tree</field>
        <field name="model">duplicate.contact.group</field>
        <field name="arch" type="xml">
            <list string="Duplicate Groups" create="false" edit="false" delete="false">
                <field name="match_type"/>
                <field name="match_value"/>
                <field name="partner_count"/>
                <field name="top_partner_id"/>
                <field name="top_activity_count"/>
                <field name="first_created"/>
                <field name="last_created"/>
                <button name="action_open_contacts" type="object" string="Contacts"
                        icon="fa-users" title="Open these contacts"/>
                <button name="action_open_merge_wizard" type="object" string="Merge"
                        icon="fa-compress" title="Open Odoo's Merge Contacts wizard"/>
            </list>
        </field>
    </record>

    <record id="view_duplicate_contact_finder_form" model="ir.ui.view">
        <field name="name">duplicate.contact.finder.form</field>
        <field name="model">duplicate.contact.finder</field>
        <field name="arch" type="xml">
            <form string="Find Duplicate Contacts">
                <header>
                    <button name="action_scan" type="object" string="Scan for Duplicates"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_scan" type="object" string="Scan Again"
                            class="btn-primary" invisible="state != 'done'"/>
                    <button name="action_reset" type="object" string="Change Criteria"
                            class="btn-secondary" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Find Duplicate Contacts</h1>
                    </div>
                    <div class="alert alert-info" role="status">
                        This scan only reads your contacts. It never merges, edits,
                        archives or deletes anything. Once you have reviewed a group,
                        hand it over to Odoo's own <b>Merge Contacts</b> wizard with the
                        Merge button on that group.
                    </div>
                    <group>
                        <group string="Match Contacts On">
                            <field name="use_email"/>
                            <field name="use_phone"/>
                            <field name="use_name"/>
                        </group>
                        <group string="Contacts to Scan">
                            <field name="contact_kind"/>
                            <field name="include_archived"/>
                            <field name="include_addresses"/>
                            <field name="max_groups"/>
                        </group>
                    </group>
                    <group invisible="state != 'done'">
                        <group>
                            <field name="group_count"/>
                            <field name="contact_count"/>
                        </group>
                        <group>
                            <field name="scanned_on"/>
                            <field name="truncated"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert" invisible="not truncated">
                        <field name="truncation_note" nolabel="1" readonly="1"/>
                    </div>
                    <div invisible="state != 'done'">
                        <separator string="Duplicate Groups"/>
                        <field name="group_ids" nolabel="1" readonly="1"/>
                        <p class="text-muted" invisible="group_count != 0">
                            No duplicate contact was found with these criteria.
                        </p>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_duplicate_contact_finder" model="ir.actions.act_window">
        <field name="name">Find Duplicate Contacts</field>
        <field name="res_model">duplicate.contact.finder</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_duplicate_contact_finder_form"/>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_duplicate_contact_finder"
              name="Find Duplicate Contacts"
              parent="contacts.res_partner_menu_config"
              action="action_duplicate_contact_finder"
              groups="base.group_system"
              sequence="90"/>

</odoo>
