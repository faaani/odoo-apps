<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_config_audit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.config.audit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='emails']" position="after">
                <h2>System Parameters</h2>
                <div class="row mt16 o_settings_container" id="config_change_audit_container">
                    <div class="col-12 col-lg-6 o_setting_box" id="config_change_audit_setting">
                        <div class="o_setting_left_pane">
                            <field name="config_audit_enabled"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="config_audit_enabled"/>
                            <div class="text-muted">
                                Record every system parameter that is created, changed or deleted,
                                with its old value, its new value and who did it.
                            </div>
                            <div class="content-group" attrs="{'invisible': [('config_audit_enabled', '=', False)]}">
                                <div class="row mt16">
                                    <label for="config_audit_retention_days" class="col-lg-4 o_light_label"/>
                                    <field name="config_audit_retention_days" class="col-lg-2"/>
                                </div>
                                <div class="row">
                                    <label for="config_audit_secret_patterns" class="col-lg-4 o_light_label"/>
                                    <field name="config_audit_secret_patterns" class="col-lg-6"/>
                                </div>
                            </div>
                            <div class="mt8">
                                <button name="%(config_change_audit.action_config_change_audit)d"
                                        type="action" string="Open the audit trail" class="btn-link"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
