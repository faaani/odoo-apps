#. module: mail_bounce_report
#: model:ir.model.fields,help:mail_bounce_report.field_mail_bounce_report__above_threshold
msgid ""
"Ticked when Bounces is greater than OR EQUAL TO the configured threshold. "
"The comparison is inclusive, matching the >= test Odoo itself uses against "
"its MAX_BOUNCE_LIMIT."
msgstr ""

#. module: mail_bounce_report
#: model:ir.model.fields,help:mail_bounce_report.field_mail_bounce_report__blacklisted
