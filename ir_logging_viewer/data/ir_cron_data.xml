<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- The cleanup is gated by the retention setting, which is off until an
             administrator enables it: while it is off this job is a no-op. -->
        <record id="ir_cron_logging_viewer_gc" model="ir.cron">
            <field name="name">Server Log Viewer: apply log retention</field>
            <field name="model_id" ref="base.model_ir_logging"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model._logging_viewer_gc()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
