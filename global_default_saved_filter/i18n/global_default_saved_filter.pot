#. module: global_default_saved_filter
#: model:ir.model.fields,help:global_default_saved_filter.field_ir_filters__global_default
msgid ""
"Apply this shared filter by default for every user who has not chosen a "
"personal default filter. A personal default always wins over this one. Only "
"a shared filter can carry the flag, and only administrators (Access Rights) "
"may change it."
msgstr ""

