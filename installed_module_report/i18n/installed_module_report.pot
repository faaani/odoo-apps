#: model:ir.model.fields,help:installed_module_report.field_installed_module_report__is_third_party
msgid ""
"Ticked for every module not published by Odoo S.A., which includes OCA "
"modules and modules whose author is missing."
msgstr ""

#. module: installed_module_report
#: model:ir.model.fields,help:installed_module_report.field_installed_module_report__nonstandard_license
msgid ""
"Ticked for every module whose licence is not LGPL-3, the licence Odoo "
"Community itself ships under: stronger copyleft (GPL, AGPL), proprietary "
"(OPL-1, OEEL-1, other), or no licence at all. Odoo Enterprise modules are "
"OEEL-1 and appear here by design."
msgstr ""

#. module: installed_module_report
#: model:ir.model.fields,help:installed_module_report.field_installed_module_report__auto_install
msgid ""
"Ticked for link modules Odoo installs by itself once their dependencies are "
"present."
msgstr ""

#. module: installed_module_report
#: model:ir.model.fields,help:installed_module_report.field_installed_module_report__application
msgid ""
"Ticked for modules that declare themselves an app, the ones with a tile in "
"the Apps screen."
msgstr ""

#. module: installed_module_report
#: model:ir.model.fields,help:installed_module_report.field_installed_module_report__standalone
msgid ""
"Ticked when the module is not an application itself, was not auto-installed "
"as a link module, and no installed module depends on it - so it was "
"installed on purpose and nothing else needs it. Only DIRECT dependencies are"
" considered."
msgstr ""

