<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_access_expiry" model="ir.ui.view">
        <field name="name">res.users.form.access.expiry</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Access Expiry" name="access_expiry">
                    <group>
                        <group string="Expiry">
                            <field name="access_expiry_date"/>
                        </group>
                        <group string="Audit" invisible="not deactivated_by_expiry">
                            <field name="deactivated_by_expiry"/>
                            <field name="expiry_deactivation_date"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_users_search_access_expiry" model="ir.ui.view">
        <field name="name">res.users.search.access.expiry</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Has Expiry Date" name="has_access_expiry"
                        domain="[('access_expiry_date', '!=', False)]"/>
                <filter string="Deactivated by Expiry" name="deactivated_by_expiry"
                        domain="[('deactivated_by_expiry', '=', True), ('active', '=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
