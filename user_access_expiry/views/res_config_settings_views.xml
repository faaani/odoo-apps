<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_access_expiry" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.access.expiry</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='invite_users']//div[@name='users_setting_container']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="expiry_notify_setting">
                    <div class="o_setting_left_pane">
                        <field name="expiry_notify_admins"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="expiry_notify_admins"/>
                        <div class="text-muted">
                            Email Settings administrators a summary whenever user accounts are archived because their access expiry date passed.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
