<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_access_expiry" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.access.expiry</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='users_setting_container']" position="inside">
                <setting string="Notify on Access Expiry" id="expiry_notify_setting"
                         help="Email Settings administrators a summary whenever user accounts are archived because their access expiry date passed.">
                    <field name="expiry_notify_admins"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
