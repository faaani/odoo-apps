<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_auto_bcc" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.auto.bcc</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='emails']" position="inside">
                <setting string="Automatic CC / BCC" id="mail_auto_bcc_setting"
                         help="Add these addresses as CC / BCC to every email this company sends through Odoo. Addresses already among the recipients are never duplicated.">
                    <div class="content-group">
                        <div class="row mt16">
                            <label for="mail_auto_cc" class="col-lg-3 o_light_label"/>
                            <field name="mail_auto_cc" class="col-lg-7"
                                   placeholder="e.g. archive@mycompany.com, sales@mycompany.com"/>
                        </div>
                        <div class="row">
                            <label for="mail_auto_bcc" class="col-lg-3 o_light_label"/>
                            <field name="mail_auto_bcc" class="col-lg-7"
                                   placeholder="e.g. compliance@mycompany.com"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
