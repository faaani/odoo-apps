<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_auto_bcc" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.auto.bcc</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='emails']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="mail_auto_bcc_setting">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">Automatic CC / BCC</span>
                        <div class="text-muted">
                            Add these addresses as CC / BCC to every email this company sends through Odoo. Addresses already among the recipients are never duplicated. Warning: the copy address receives your company's outgoing mail - treat that mailbox as privileged. Password reset and invitation emails are never copied.
                        </div>
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="mail_auto_cc" class="col-lg-3 o_light_label"/>
                                <field name="mail_auto_cc" class="col-lg-7"
                                       placeholder="e.g. archive@mycompany.com, sales@mycompany.com"/>
                            </div>
                            <div class="row">
                                <label for="mail_auto_bcc" class="col-lg-3 o_light_label"/>
                                <field name="mail_auto_bcc" class="col-lg-7"
                                       placeholder="e.g. compliance@mycompany.com"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
