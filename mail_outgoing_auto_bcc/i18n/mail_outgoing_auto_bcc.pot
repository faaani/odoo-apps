#. module: mail_outgoing_auto_bcc
#: model:ir.model.fields,help:mail_outgoing_auto_bcc.field_res_config_settings__mail_auto_bcc
msgid ""
"Comma-separated email addresses added as BCC to every outgoing email of this"
" company. Leave empty to disable. Warning: these mailboxes receive your "
"outgoing mail - treat them as privileged. Password reset and invitation "
"emails are never copied."
msgstr ""

