#. module: mail_outgoing_auto_bcc
#: model_terms:ir.ui.view,arch_db:mail_outgoing_auto_bcc.res_config_settings_view_form_auto_bcc
msgid ""
"Add these addresses as CC / BCC to every email this company sends through "
"Odoo. Addresses already among the recipients are never duplicated. Warning: "
"the copy address receives your company's outgoing mail - treat that mailbox "
"as privileged. Password reset and invitation emails are never copied."
msgstr ""

