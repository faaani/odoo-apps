<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_email_history" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.email.history</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='emails']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="keep_email_history_setting">
                    <div class="o_setting_left_pane">
                        <field name="keep_email_history"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="keep_email_history"/>
                        <div class="text-muted">
                            Keep notification and template emails after sending instead of letting Odoo delete them, so Technical &gt; Emails stays a complete audit trail.
                        </div>
                        <div class="content-group" attrs="{'invisible': [('keep_email_history', '=', False)]}">
                            <div class="row mt16">
                                <label for="keep_email_history_days" class="col-lg-4 o_light_label"/>
                                <field name="keep_email_history_days" class="col-lg-2"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
