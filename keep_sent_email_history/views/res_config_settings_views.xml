<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_email_history" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.email.history</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='emails']" position="inside">
                <setting string="Keep Sent Email History" id="keep_email_history_setting"
                         help="Keep notification and template emails after sending instead of letting Odoo delete them, so Technical &gt; Emails stays a complete audit trail.">
                    <field name="keep_email_history"/>
                    <div class="content-group" invisible="not keep_email_history">
                        <div class="row mt16">
                            <label for="keep_email_history_days" class="col-lg-4 o_light_label"/>
                            <field name="keep_email_history_days" class="col-lg-2"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
