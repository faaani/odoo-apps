<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_user_permission_diff_form" model="ir.ui.view">
        <field name="name">user.permission.diff.form</field>
        <field name="model">user.permission.diff</field>
        <field name="arch" type="xml">
            <form string="Compare User Permissions">
                <field name="copy_count" invisible="1"/>
                <field name="computed" invisible="1"/>
                <group>
                    <group>
                        <field name="user_a_id" options="{'no_create': True}"/>
                        <field name="user_b_id" options="{'no_create': True}"/>
                    </group>
                    <group>
                        <field name="compare_mode"/>
                    </group>
                </group>
                <div class="alert alert-info" role="status" style="white-space: pre-line;">
                    <field name="notice" nolabel="1" readonly="1"
                           placeholder="Choose two users and press Compare."/>
                </div>
                <div class="row">
                    <div class="col-lg-4">
                        <h5><field name="only_a_title" nolabel="1" readonly="1"/></h5>
                        <field name="only_a_line_ids" nolabel="1" readonly="1">
                            <list string="Only User A" create="false" edit="false" delete="false">
                                <field name="group_name" string="Group"/>
                                <field name="category_name" string="Application" optional="hide"/>
                                <field name="source_a" string="How A has it"/>
                                <field name="to_copy" string="Copied" optional="show"/>
                            </list>
                        </field>
                    </div>
                    <div class="col-lg-4">
                        <h5><field name="only_b_title" nolabel="1" readonly="1"/></h5>
                        <field name="only_b_line_ids" nolabel="1" readonly="1">
                            <list string="Only User B" create="false" edit="false" delete="false">
                                <field name="group_name" string="Group"/>
                                <field name="category_name" string="Application" optional="hide"/>
                                <field name="source_b" string="How B has it"/>
                            </list>
                        </field>
                    </div>
                    <div class="col-lg-4">
                        <h5><field name="shared_title" nolabel="1" readonly="1"/></h5>
                        <field name="shared_line_ids" nolabel="1" readonly="1">
                            <list string="Shared" create="false" edit="false" delete="false">
                                <field name="group_name" string="Group"/>
                                <field name="category_name" string="Application" optional="hide"/>
                                <field name="source_a" string="A"/>
                                <field name="source_b" string="B"/>
                            </list>
                        </field>
                    </div>
                </div>
                <separator string="Model permissions this difference grants"/>
                <field name="model_line_ids" nolabel="1" readonly="1">
                    <list string="Model Permissions" create="false" edit="false" delete="false">
                        <field name="side_label" string="Who"/>
                        <field name="model_id" string="Model"/>
                        <field name="model_name" string="Technical Model" optional="hide"/>
                        <field name="rights_code" string="Extra Rights"/>
                        <field name="perm_read" string="Read" optional="show"/>
                        <field name="perm_write" string="Write" optional="show"/>
                        <field name="perm_create" string="Create" optional="show"/>
                        <field name="perm_unlink" string="Delete" optional="show"/>
                    </list>
                </field>
                <footer>
                    <button name="action_compare" string="Compare" type="object"
                            class="btn-primary"/>
                    <button name="action_open_copy" type="object" class="btn-secondary"
                            string="Copy missing groups from A to B"
                            invisible="copy_count == 0"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_user_permission_diff" model="ir.actions.act_window">
        <field name="name">Compare User Permissions</field>
        <field name="res_model">user.permission.diff</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_user_permission_diff_form"/>
        <field name="target">new</field>
        <field name="binding_model_id" ref="base.model_res_users"/>
        <field name="binding_view_types">list</field>
        <field name="group_ids" eval="[(4, ref('base.group_system'))]"/>
    </record>

</odoo>
