<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_partner_filter_private_address" model="ir.ui.view">
        <field name="name">res.partner.search.private.address</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Private Addresses" name="filter_private_address"
                        domain="[('type', '=', 'private')]"
                        groups="partner_private_address_type.group_private_address"/>
            </xpath>
        </field>
    </record>
</odoo>
