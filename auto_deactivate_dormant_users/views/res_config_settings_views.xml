<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_dormancy" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.dormancy</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='users_setting_container']" position="inside">
                <setting string="Auto Deactivate Dormant Users" id="dormancy_setting"
                         help="Automatically archive internal users who have not logged in for the period below. Administrators, OdooBot and portal users are never touched.">
                    <field name="dormancy_enabled"/>
                    <div class="content-group" invisible="not dormancy_enabled">
                        <div class="row mt16">
                            <label for="dormancy_days" class="col-lg-4 o_light_label"/>
                            <field name="dormancy_days" class="col-lg-2"/>
                        </div>
                        <div class="row">
                            <label for="dormancy_include_never_logged" class="col-lg-4 o_light_label"/>
                            <field name="dormancy_include_never_logged"/>
                        </div>
                        <div class="row">
                            <label for="dormancy_notify_admins" class="col-lg-4 o_light_label"/>
                            <field name="dormancy_notify_admins"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
