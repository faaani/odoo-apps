<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_activity_digest" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.activity.digest</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='emails']" position="after">
                <h2>Activities</h2>
                <div class="row mt16 o_settings_container" id="activity_digest_container">
                    <div class="col-12 col-lg-6 o_setting_box" id="activity_digest_setting">
                        <div class="o_setting_left_pane">
                            <field name="activity_digest_enabled"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="activity_digest_enabled"/>
                            <div class="text-muted">
                                Email each user who opted in a morning summary of the activities they must deal with. Users with nothing due are not emailed.
                            </div>
                            <div class="content-group" attrs="{'invisible': [('activity_digest_enabled', '=', False)]}">
                                <div class="mt16 text-muted">
                                    Each user switches the digest on for themselves under
                                    Preferences &gt; Activity Digest. The sending time lives in
                                    Settings &gt; Technical &gt; Scheduled Actions
                                    ("Send daily activity digest emails").
                                </div>
                                <button name="action_activity_digest_enable_all" type="object"
                                        string="Turn on for all internal users"
                                        class="btn-link mt8" icon="fa-envelope-o"
                                        confirm="Every active internal user will start receiving the daily digest. They can switch it off again in their own preferences. Continue?"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
