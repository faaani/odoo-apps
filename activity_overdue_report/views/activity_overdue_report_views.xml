<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_activity_overdue_report_list" model="ir.ui.view">
        <field name="name">activity.overdue.report.list</field>
        <field name="model">activity.overdue.report</field>
        <field name="arch" type="xml">
            <list string="Overdue Activities" create="false" edit="false" delete="false"
                  decoration-danger="days_overdue &gt; 7"
                  decoration-warning="urgency == 'overdue' and days_overdue &lt;= 7"
                  decoration-info="urgency == 'today'">
                <field name="date_deadline"/>
                <field name="days_overdue" avg="Average"/>
                <field name="urgency"/>
                <field name="user_id"/>
                <field name="activity_type_id"/>
                <field name="summary" optional="show"/>
                <field name="res_model_id" optional="show"/>
                <field name="document_name"/>
                <button name="action_open_document" type="object" string="Open"
                        icon="fa-external-link" title="Open the document"/>
                <field name="res_model" optional="hide"/>
                <field name="res_id" optional="hide"/>
                <field name="res_name" optional="hide"/>
                <field name="creator_id" optional="hide"/>
                <field name="activity_create_date" optional="hide"/>
                <field name="document_missing" optional="hide"/>
                <field name="activity_count" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_activity_overdue_report_form" model="ir.ui.view">
        <field name="name">activity.overdue.report.form</field>
        <field name="model">activity.overdue.report</field>
        <field name="arch" type="xml">
            <form string="Overdue Activity" create="false" edit="false" delete="false">
                <header>
                    <button name="action_open_document" type="object" class="btn-primary"
                            string="Open Document"/>
                </header>
                <sheet>
                    <group>
                        <group string="Activity">
                            <field name="activity_type_id"/>
                            <field name="summary"/>
                            <field name="user_id"/>
                            <field name="creator_id"/>
                            <field name="activity_create_date"/>
                        </group>
                        <group string="Deadline">
                            <field name="date_deadline"/>
                            <field name="days_overdue"/>
                            <field name="urgency"/>
                        </group>
                        <group string="Document">
                            <field name="res_model_id"/>
                            <field name="res_model"/>
                            <field name="res_id"/>
                            <field name="document_name"/>
                            <field name="document_ref"/>
                            <field name="document_missing"/>
                            <field name="res_name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_activity_overdue_report_pivot" model="ir.ui.view">
        <field name="name">activity.overdue.report.pivot</field>
        <field name="model">activity.overdue.report</field>
        <field name="arch" type="xml">
            <pivot string="Overdue Activities" sample="0">
                <field name="user_id" type="row"/>
                <field name="activity_type_id" type="col"/>
                <field name="activity_count" type="measure"/>
                <field name="days_overdue" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_activity_overdue_report_graph" model="ir.ui.view">
        <field name="name">activity.overdue.report.graph</field>
        <field name="model">activity.overdue.report</field>
        <field name="arch" type="xml">
            <graph string="Overdue Activities" type="bar" sample="0">
                <field name="user_id"/>
                <field name="activity_count" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_activity_overdue_report_search" model="ir.ui.view">
        <field name="name">activity.overdue.report.search</field>
        <field name="model">activity.overdue.report</field>
        <field name="arch" type="xml">
            <search string="Overdue Activities">
                <field name="user_id"/>
                <field name="activity_type_id"/>
                <field name="res_model_id" string="Document Model"/>
                <field name="summary"
                       filter_domain="['|', ('summary', 'ilike', self), ('res_name', 'ilike', self)]"
                       string="Summary or Document"/>
                <field name="days_overdue" string="Overdue by at least (days)"
                       filter_domain="[('days_overdue', '&gt;=', self)]"/>
                <filter string="Overdue" name="overdue"
                        domain="[('urgency', '=', 'overdue')]"/>
                <filter string="Due Today" name="due_today"
                        domain="[('urgency', '=', 'today')]"/>
                <filter string="Due This Week (next 7 days)" name="due_week"
                        domain="[('date_deadline', '&gt;=', context_today().strftime('%Y-%m-%d')),
                                 ('date_deadline', '&lt;=', (context_today() + relativedelta(days=6)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Overdue 7+ Days" name="overdue_7"
                        domain="[('days_overdue', '&gt;=', 7)]"/>
                <filter string="Overdue 30+ Days" name="overdue_30"
                        domain="[('days_overdue', '&gt;=', 30)]"/>
                <separator/>
                <filter string="Assigned to Me" name="my_activities"
                        domain="[('user_id', '=', uid)]"/>
                <filter string="Scheduled by Me" name="created_by_me"
                        domain="[('creator_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Assigned To" name="group_user"
                            context="{'group_by': 'user_id'}"/>
                    <filter string="Activity Type" name="group_type"
                            context="{'group_by': 'activity_type_id'}"/>
                    <filter string="Document Model" name="group_model"
                            context="{'group_by': 'res_model_id'}"/>
                    <filter string="Status" name="group_urgency"
                            context="{'group_by': 'urgency'}"/>
                    <filter string="Due Date" name="group_deadline"
                            context="{'group_by': 'date_deadline'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_activity_overdue_report" model="ir.actions.act_window">
        <field name="name">Overdue Activities</field>
        <field name="res_model">activity.overdue.report</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="search_view_id" ref="view_activity_overdue_report_search"/>
        <field name="context">{'search_default_overdue': 1, 'search_default_group_user': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing is overdue</p>
            <p>This read-only report lists every open activity with the person it
               is assigned to, the document it belongs to and how many days late
               it is. You see an activity when it is assigned to you, or when you
               are allowed to read the document it is attached to.</p>
        </field>
    </record>

    <menuitem id="menu_activity_overdue_root"
              name="Activities"
              web_icon="activity_overdue_report,static/description/icon.png"
              sequence="95"/>

    <menuitem id="menu_activity_overdue_report"
              name="Overdue Activities"
              parent="menu_activity_overdue_root"
              action="action_activity_overdue_report"
              groups="base.group_user"
              sequence="10"/>

</odoo>
