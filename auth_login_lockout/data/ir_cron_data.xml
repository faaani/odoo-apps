<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_gc_login_attempts" model="ir.cron">
            <field name="name">Login Lockout: purge old login attempts</field>
            <field name="model_id" ref="model_auth_login_attempt"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model._gc_login_attempts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
