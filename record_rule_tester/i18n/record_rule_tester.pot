#. module: record_rule_tester
#. odoo-python
#: code:addons/record_rule_tester/wizard/record_rule_tester.py:0
msgid ""
"%(model)s delegates to %(parents)s through _inherits. Odoo also applies the "
"record rules of those parent models, and this screen lists only the rules "
"defined on %(model)s - run the test again on a parent model to see them."
msgstr ""

#. module: record_rule_tester
#. odoo-python
#: code:addons/record_rule_tester/wizard/record_rule_tester.py:0
msgid ""
"%(user)s can read %(model)s #%(record)s: the record satisfies every record "
"rule that applies to them."
msgstr ""

