<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_record_rule_tester_form" model="ir.ui.view">
        <field name="name">record.rule.tester.form</field>
        <field name="model">record.rule.tester</field>
        <field name="arch" type="xml">
            <form string="Record Rule Tester">
                <header>
                    <button name="action_run" string="Run Test" type="object"
                            class="oe_highlight"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Record Rule Tester</h1>
                        <p class="text-muted">
                            Pick a user and a model, press Run Test, and see the
                            record rules Odoo applies to them, how many records
                            they can reach, and - if you give a record id - why
                            that one record is or is not visible.
                        </p>
                    </div>
                    <group>
                        <group string="What To Test" name="input">
                            <field name="user_id" options="{'no_create': True}"/>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="model_name"/>
                            <field name="record_id"/>
                            <field name="count_limit"/>
                        </group>
                        <group string="Result" name="result">
                            <field name="access_state"/>
                            <field name="readable_count"/>
                            <field name="reference_count"/>
                            <field name="counts_capped"/>
                            <field name="global_rule_count"/>
                            <field name="group_rule_count"/>
                            <field name="company_names"/>
                        </group>
                    </group>
                    <group string="Model Access" name="access">
                        <field name="access_message" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Verdict On The Record" name="verdict">
                        <field name="record_verdict"/>
                        <field name="record_message" nolabel="1" colspan="2"/>
                    </group>
                    <notebook>
                        <page string="Operations" name="operations">
                            <field name="op_ids" nolabel="1">
                                <list string="Operations" create="false"
                                      edit="false" delete="false"
                                      decoration-muted="not acl_allowed">
                                    <field name="operation"/>
                                    <field name="acl_allowed"/>
                                    <field name="rule_count"/>
                                    <field name="countable"/>
                                    <field name="record_count"/>
                                    <field name="capped"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>
                        <page string="Applicable Record Rules" name="rules">
                            <p class="text-muted">
                                Global rules carry no group: Odoo ANDs them with
                                everything else, so one that does not match is
                                enough to hide a record. Group rules are ORed
                                with each other. Domains are shown exactly as
                                stored - expressions such as
                                <code>user.company_id</code> are not expanded
                                here; what counts is the evaluated result above.
                            </p>
                            <field name="rule_ids" nolabel="1">
                                <list string="Applicable Record Rules"
                                      create="false" edit="false" delete="false"
                                      decoration-danger="blocks_record">
                                    <field name="kind"/>
                                    <field name="rule_name"/>
                                    <field name="group_names"/>
                                    <field name="domain_force"/>
                                    <field name="perm_read"/>
                                    <field name="perm_write"/>
                                    <field name="perm_create"/>
                                    <field name="perm_unlink"/>
                                    <field name="blocks_record"/>
                                    <field name="rule_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="warning" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_record_rule_tester" model="ir.actions.act_window">
        <field name="name">Record Rule Tester</field>
        <field name="res_model">record.rule.tester</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_record_rule_tester_form"/>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_record_rule_tester"
              name="Record Rule Tester"
              parent="base.menu_users"
              action="action_record_rule_tester"
              groups="base.group_system"
              sequence="35"/>

</odoo>
