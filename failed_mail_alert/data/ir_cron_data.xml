<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_failed_mail_alert" model="ir.cron">
            <field name="name">Email: alert on a stuck outgoing queue</field>
            <field name="model_id" ref="mail.model_mail_mail"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="state">code</field>
            <field name="code">model._failed_mail_alert_check()</field>
            <field name="interval_number">4</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
