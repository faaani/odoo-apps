<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_failed_mail_alert" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.failed.mail.alert</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='emails']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="failed_mail_alert_setting">
                    <div class="o_setting_left_pane">
                        <field name="failed_mail_alert_enabled"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="failed_mail_alert_enabled"/>
                        <div class="text-muted">
                            Warn administrators by email when outgoing messages stop being delivered and pile up in the queue.
                        </div>
                        <div class="content-group" attrs="{'invisible': [('failed_mail_alert_enabled', '=', False)]}">
                            <div class="row mt16">
                                <label for="failed_mail_alert_threshold" class="col-lg-8 o_light_label"/>
                                <field name="failed_mail_alert_threshold" class="col-lg-2"/>
                            </div>
                            <div class="row">
                                <label for="failed_mail_alert_age_minutes" class="col-lg-8 o_light_label"/>
                                <field name="failed_mail_alert_age_minutes" class="col-lg-2"/>
                            </div>
                            <div class="text-muted mt8">
                                Checked every 4 hours; at most one alert every 24 hours.
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
