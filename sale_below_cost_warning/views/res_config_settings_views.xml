<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_below_cost" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.below.cost</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">
                <setting string="Below-Cost Sales Check" id="below_cost_warning_setting"
                         help="Warn while quoting, and optionally block confirmation, when a line's unit price after discount falls below the product cost.">
                    <div class="content-group">
                        <div class="row mt8">
                            <label for="below_cost_mode" string="Mode" class="col-lg-3 o_light_label"/>
                            <field name="below_cost_mode" class="col-lg-7"/>
                        </div>
                        <div class="row mt8" invisible="below_cost_mode == 'off'">
                            <div class="col-12 d-flex align-items-center">
                                <field name="below_cost_flag_zero_price" nolabel="1" class="me-2"/>
                                <label for="below_cost_flag_zero_price" class="o_light_label mb-0"/>
                            </div>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
