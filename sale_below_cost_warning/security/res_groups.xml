<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_sell_below_cost" model="res.groups">
        <field name="name">Allow selling below cost</field>
        <!-- Deliberately NO privilege_id: a group carrying the Sales privilege
             becomes a mutually exclusive option of the Sales access-level
             dropdown, so selecting it would strip the user's Sales role.
             Without a privilege the group renders as an Extra Rights checkbox
             (developer mode), leaving the Sales dropdown untouched. -->
        <field name="comment">Members can confirm a sale order even when block mode is enabled and a line's unit price after discount is below the product cost.</field>
    </record>
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_sell_below_cost'))]"/>
    </record>
</odoo>
