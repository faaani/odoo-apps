#. module: external_id_manager
#: model_terms:ir.ui.view,arch_db:external_id_manager.view_external_id_entry_form
msgid ""
"This external ID is broken: the record it points to no longer\n"
"                        exists, so <code>env.ref()</code> on it fails and an import\n"
"                        using it will not update anything."
msgstr ""

#. module: external_id_manager
#: model_terms:ir.ui.view,arch_db:external_id_manager.view_external_id_entry_form
#: model_terms:ir.ui.view,arch_db:external_id_manager.view_external_id_entry_list
msgid ""
"This external ID points to a record that no longer exists, so deleting it "
"removes a dead reference only. Live external IDs are never deleted here: "
"deleting a live one silently breaks module upgrades, because the next "
"upgrade of its module no longer finds the record and creates a duplicate "
"instead of updating it. Delete this broken entry?"
msgstr ""

#. module: external_id_manager
#: model_terms:ir.actions.act_window,help:external_id_manager.action_external_id_entry
msgid ""
"This screen is read-only. The only deletion it allows is that of a\n"
"               broken entry, and it always asks for confirmation: deleting a live\n"
"               external ID silently breaks module upgrades, because the next\n"
"               upgrade of its module no longer finds the record and creates a\n"
"               duplicate instead of updating it."
msgstr ""

